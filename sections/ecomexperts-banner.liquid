{% comment %}
  ==========================================================================
  Ecomexperts Banner Section
  Built from scratch for Ecomexperts Shopify Developer Assessment
  Features:
  - Unified Top Header with Left Brand Logo, Center Announcement, Right CTA Button
  - Background line-art illustration banner with bottom-left text overlay
  - Heavy Heading, Multiline Subtitle, and animated SHOP NOW button
  - Bottom Ribbon Ticker (XXS TO 6XL)
  - All text fields fully editable via Customizer settings
  ==========================================================================
{% endcomment %}

{{ 'ecomexperts-style.css' | asset_url | stylesheet_tag }}

<section class="ecomexperts-wrapper ee-banner-section" id="ee-banner-{{ section.id }}">
  <!-- Top Unified Header & Announcement Bar -->
  <header class="ee-banner-topbar">
    <div class="ee-topbar-left">
      <a href="/" class="ee-brand-logo ee-editable-highlight">
        {{ section.settings.brand_logo_text }}
      </a>
    </div>

    <div class="ee-topbar-center">
      <p class="ee-announcement-text ee-editable-highlight">
        {{ section.settings.announcement_text }}
      </p>
    </div>

    <div class="ee-topbar-right">
      {% if section.settings.announcement_cta_text != blank %}
        <a href="{{ section.settings.announcement_cta_url }}" class="ee-topbar-cta ee-editable-highlight">
          <span>{{ section.settings.announcement_cta_text }}</span>
          <span class="ee-arrow">→</span>
        </a>
      {% endif %}
    </div>
  </header>

  <!-- Hero Banner with Background Illustration & Content Overlay -->
  <div
    class="ee-hero-banner"
    style="background-image: url('{% if section.settings.banner_image != blank %}{{ section.settings.banner_image | image_url: width: 1800 }}{% else %}{{ 'ecomexperts-banner-illustration.png' | asset_url }}{% endif %}');"
  >
    <div class="ee-hero-overlay-content">
      <h1 class="ee-hero-heading ee-editable-highlight">
        {{ section.settings.banner_heading }}
      </h1>
      
      <p class="ee-hero-subtitle ee-editable-highlight">
        {{ section.settings.banner_subheading | newline_to_br }}
      </p>

      {% if section.settings.banner_cta_text != blank %}
        <a href="{{ section.settings.banner_cta_url }}" class="ee-btn-primary ee-editable-highlight">
          <span>{{ section.settings.banner_cta_text }}</span>
          <span class="ee-arrow">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Full-Width Ribbon Ticker Bar -->
  <div class="ee-ribbon-bar">
    <p class="ee-ribbon-text ee-editable-highlight">
      {{ section.settings.ribbon_text }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Ecomexperts Banner",
  "tag": "section",
  "class": "ecomexperts-banner-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Top Header & Announcement Settings"
    },
    {
      "type": "text",
      "id": "brand_logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "announcement_cta_text",
      "label": "Announcement Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "announcement_cta_url",
      "label": "Announcement Button URL"
    },
    {
      "type": "header",
      "content": "Hero Banner Settings"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Hero Background Illustration / Image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Hero Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "banner_subheading",
      "label": "Hero Subtitle",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to\ndelight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "banner_cta_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "banner_cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Ribbon Ticker Settings"
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Ribbon Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Ecomexperts Banner",
      "category": "Hero"
    }
  ]
}
{% endschema %}
